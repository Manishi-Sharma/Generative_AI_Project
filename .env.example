# ==============================================================================
# The Financial Butterfly Effect - Environment Configuration Template
# Copy this file to .env and insert your real credentials.
# ==============================================================================

# Database URL:
# For SQLite (default local file):
DATABASE_URL=sqlite:///./financial_butterfly.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/financial_butterfly

# Application Security Secret
SECRET_KEY=replace-with-a-very-long-random-secret-key-32chars

# NVIDIA NIM AI Configuration
# Get your API key from https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Nemotron instruction/reasoning model
NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct
NVIDIA_TIMEOUT_SECONDS=30

# Regional Localization
DEFAULT_CURRENCY=₹
CURRENCY_CODE=INR
